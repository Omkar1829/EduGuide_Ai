generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Job {
  id           String    @id @default(uuid())
  title        String
  description  String?
  company      String
  location     String?
  url          String?   @unique
  salaryRange  String?
  experience   String?
  skills       String[]
  category     String
  type         String    @default("full-time")
  isActive     Boolean   @default(true)
  postedAt     DateTime? @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([category])
  @@index([location])
  @@index([isActive])
  @@index([postedAt])
  @@map("jobs")
}
