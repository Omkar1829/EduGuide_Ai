generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== ENUMS ====================

enum UserRole {
  STUDENT
  ADMIN
}

enum SubscriptionTier {
  NEWBIE
  PRO
  PRO_PLUS
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum AcademicYear {
  FRESHMAN
  SOPHOMORE
  JUNIOR
  SENIOR
  GRADUATE
  POST_GRADUATE
}

enum RecommendationType {
  CAREER
  STREAM
  COURSE
  SKILL
  JOB
}

enum RecommendationStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

enum QuizCategory {
  CAREER_INTEREST
  PERSONALITY
  SKILL_ASSESSMENT
  APTITUDE
  LEARNING_STYLE
}

enum NotificationType {
  RECOMMENDATION
  QUIZ_RESULT
  ROADMAP_UPDATE
  COURSE_UPDATE
  JOB_ALERT
  SYSTEM
  CHAT
}

enum ChatRole {
  USER
  ASSISTANT
  SYSTEM
}

enum ResumeStatus {
  PENDING
  ANALYZED
  FAILED
}

// ==================== CORE TABLES ====================

model User {
  id            String   @id @default(uuid()) @db.Uuid
  email         String   @unique
  passwordHash  String
  firstName     String
  lastName      String
  role          UserRole @default(STUDENT)
  subscriptionTier  SubscriptionTier @default(NEWBIE)
  chatLimitRemaining Int @default(5)
  lastLimitReset    DateTime @default(now())
  isVerified    Boolean  @default(false)
  isActive      Boolean  @default(true)
  avatarUrl     String?
  lastLoginAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  profile           StudentProfile?
  recommendations   Recommendation[]
  careerRoadmaps    CareerRoadmap[]
  quizzes           Quiz[]
  quizResults       QuizResult[]
  chatHistory       ChatHistory[]
  resumeAnalysis    ResumeAnalysis[]
  notifications     Notification[]
  userCourses       UserCourse[]
  userJobs          UserJob[]
  refreshTokens     RefreshToken[]

  @@index([email])
  @@index([role])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique
  userId    String   @db.Uuid
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

// ==================== PROFILE TABLES ====================

model StudentProfile {
  id              String       @id @default(uuid()) @db.Uuid
  userId          String       @unique @db.Uuid
  dateOfBirth     DateTime?
  gender          Gender?
  phoneNumber     String?
  address         String?
  city            String?
  state           String?
  country         String?      @default("India")
  bio             String?
  profileComplete Boolean      @default(false)
  completionPct   Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  academicRecords AcademicRecord[]
  interests       Interest[]
  careerGoals     CareerGoal[]
  strengths       Strength[]
  weaknesses      Weakness[]
  skills          StudentSkill[]
  certifications  Certification[]

  @@index([userId])
  @@map("student_profiles")
}

model AcademicRecord {
  id             String        @id @default(uuid()) @db.Uuid
  profileId      String        @db.Uuid
  institution    String
  degree         String
  fieldOfStudy   String
  year           AcademicYear
  startYear      Int
  endYear        Int?
  gpa            Float?
  percentage     Float?
  isCurrent      Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  profile      StudentProfile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  subjectMarks SubjectMark[]

  @@index([profileId])
  @@map("academic_records")
}

model SubjectMark {
  id              String         @id @default(uuid()) @db.Uuid
  academicRecordId String        @db.Uuid
  subjectName     String
  marks           Float
  maxMarks        Float          @default(100)
  grade           String?
  createdAt       DateTime       @default(now())

  academicRecord AcademicRecord @relation(fields: [academicRecordId], references: [id], onDelete: Cascade)

  @@index([academicRecordId])
  @@map("subject_marks")
}

// ==================== INTERESTS & GOALS ====================

model Interest {
  id        String   @id @default(uuid()) @db.Uuid
  profileId String   @db.Uuid
  name      String
  category  String?
  level     Int      @default(1)
  createdAt DateTime @default(now())

  profile StudentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, name])
  @@index([profileId])
  @@map("interests")
}

model CareerGoal {
  id          String   @id @default(uuid()) @db.Uuid
  profileId   String   @db.Uuid
  title       String
  description String?
  targetYear  Int?
  priority    Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  profile StudentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("career_goals")
}

model Strength {
  id        String   @id @default(uuid()) @db.Uuid
  profileId String   @db.Uuid
  name      String
  category  String?
  evidence  String?
  createdAt DateTime @default(now())

  profile StudentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, name])
  @@index([profileId])
  @@map("strengths")
}

model Weakness {
  id        String   @id @default(uuid()) @db.Uuid
  profileId String   @db.Uuid
  name      String
  category  String?
  evidence  String?
  createdAt DateTime @default(now())

  profile StudentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, name])
  @@index([profileId])
  @@map("weaknesses")
}

// ==================== SKILLS & CERTIFICATIONS ====================

model StudentSkill {
  id          String   @id @default(uuid()) @db.Uuid
  profileId   String   @db.Uuid
  skillId     String   @db.Uuid
  level       Int      @default(1)
  yearsExp    Int?
  isVerified  Boolean  @default(false)
  createdAt   DateTime @default(now())

  profile StudentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skill   Skill          @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([profileId, skillId])
  @@index([profileId])
  @@index([skillId])
  @@map("student_skills")
}

model Skill {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  category  String
  createdAt DateTime @default(now())

  studentSkills StudentSkill[]

  @@index([category])
  @@map("skills")
}

model Certification {
  id            String    @id @default(uuid()) @db.Uuid
  profileId     String    @db.Uuid
  name          String
  issuer        String
  issueDate     DateTime?
  expiryDate    DateTime?
  credentialUrl String?
  createdAt     DateTime  @default(now())

  profile StudentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("certifications")
}

// ==================== COURSES & JOBS ====================

model Course {
  id            String   @id @default(uuid()) @db.Uuid
  title         String
  description   String?
  provider      String
  url           String?
  duration      String?
  level         String?
  category      String
  price         Float?
  currency      String?  @default("INR")
  rating        Float?
  enrolledCount Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  userCourses UserCourse[]

  @@index([category])
  @@index([provider])
  @@index([isActive])
  @@map("courses")
}

model UserCourse {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  courseId    String   @db.Uuid
  status     String   @default("enrolled")
  progress   Int      @default(0)
  enrolledAt DateTime @default(now())
  completedAt DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@map("user_courses")
}

model Job {
  id            String   @id @default(uuid()) @db.Uuid
  title         String
  description   String?
  company       String
  location      String?
  url           String?
  salaryRange   String?
  experience    String?
  skills        String[]
  category      String
  type          String?  @default("full-time")
  isActive      Boolean  @default(true)
  postedAt      DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  userJobs UserJob[]

  @@index([category])
  @@index([company])
  @@index([isActive])
  @@index([postedAt])
  @@map("jobs")
}

model UserJob {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  jobId      String   @db.Uuid
  status     String   @default("saved")
  appliedAt  DateTime?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId])
  @@index([jobId])
  @@map("user_jobs")
}

// ==================== RECOMMENDATIONS ====================

model Recommendation {
  id          String               @id @default(uuid()) @db.Uuid
  userId      String               @db.Uuid
  type        RecommendationType
  title       String
  description String
  confidence  Float
  reasoning   Json
  metadata    Json?
  status      RecommendationStatus @default(PENDING)
  expiresAt   DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([userId, status])
  @@map("recommendations")
}

// ==================== ROADMAPS ====================

model CareerRoadmap {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  title       String
  description String?
  targetCareer String
  phases      Json
  progress    Int      @default(0)
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("career_roadmaps")
}

// ==================== QUIZ SYSTEM ====================

model Quiz {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @db.Uuid
  title       String
  category    QuizCategory
  questions   Json
  status      String        @default("in_progress")
  totalScore  Float?
  maxScore    Float?
  duration    Int?
  startedAt   DateTime      @default(now())
  completedAt DateTime?
  createdAt   DateTime      @default(now())

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  results     QuizResult[]

  @@index([userId, category])
  @@map("quizzes")
}

model QuizResult {
  id          String   @id @default(uuid()) @db.Uuid
  quizId      String   @db.Uuid
  userId      String   @db.Uuid
  score       Float
  maxScore    Float
  percentage  Float
  answers     Json
  analysis    Json?
  createdAt   DateTime @default(now())

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([quizId])
  @@index([userId])
  @@map("quiz_results")
}

// ==================== AI CHAT ====================

model ChatHistory {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  sessionId String
  role      ChatRole
  content   String
  metadata  Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, sessionId])
  @@index([userId, createdAt])
  @@map("chat_history")
}

// ==================== RESUME ANALYSIS ====================

model ResumeAnalysis {
  id              String       @id @default(uuid()) @db.Uuid
  userId          String       @db.Uuid
  fileName        String
  fileUrl         String?
  status          ResumeStatus @default(PENDING)
  parsedContent   Json?
  analysis        Json?
  score           Float?
  feedback        Json?
  recommendations Json?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("resume_analysis")
}

// ==================== NOTIFICATIONS ====================

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  type      NotificationType
  title     String
  message   String
  data      Json?
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

// ==================== KNOWLEDGE CENTER ====================

model KnowledgeArticle {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  summary     String
  content     String
  category    String
  industry    String
  url         String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([industry])
  @@map("knowledge_articles")
}
